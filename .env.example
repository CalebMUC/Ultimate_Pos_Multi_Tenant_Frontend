# Everything prefixed NEXT_PUBLIC_ ships to the browser. Never put secrets here.
# Either call the API directly (list this origin in the API's Cors:AllowedOrigins)...
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
# ...or go through the Next.js proxy (next.config.mjs) and set its target:
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://localhost:5062
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_DEFAULT_UTC_OFFSET_MINUTES=180
# Shown on blocking screens and the licence page. Optional.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
